import Blaster

namespace Test.SmtHigherOrderRendering

open Blaster.Options Blaster.Optimize Blaster.Smt

/-! ## Test objectives to validate the cvc5 rendering of function values

    Blaster encodes Lean function values as SMT `Array`s: `Array` sorts,
    `lambda` terms and `select` applications. z3 receives this canonical
    encoding unchanged. cvc5 receives a higher-order rendering
    (`SmtCommand.toHigherOrder`): `Array` sorts become `->` sorts and `select`
    becomes `@`, under the logic `HO_ALL`, which is only used once the query
    contains a function value (`SmtCommand.usesFunctionValues`).

    These tests need no solver. They pin:
     - z3 rendering is the identity, byte for byte;
     - the cvc5 rendering of canonicalization (`@canon…`), application,
       equality and `get-value` on function terms;
     - the function-value detection, positive and negative;
     - that `HO_ALL` is selected only by function-valued commands and only for
       cvc5 (z3 has no `set-logic` and its setup never changes).
-/

private def fSym := mkReservedSymbol "@f"
private def gSym := mkNormalSymbol "g"
private def xSym := mkReservedSymbol "@x0"
private def funSort := arraySort #[intSort, intSort]
private def fId := smtSimpleVarId fSym
private def xId := smtSimpleVarId xSym

/-- Canonicalization wrapper, as generated by `generateFunInstDeclAux`. -/
private def canonCmd : SmtCommand :=
  .defineFun false (mkReservedSymbol "@canon") #[(fSym, funSort)] funSort
    (mkLambdaTerm #[(xSym, intSort)]
      (iteSmt (mkSimpleSmtAppN (mkReservedSymbol "@isInt") #[xId])
        (selectSmt fId #[xId]) (smtSimpleVarId (mkReservedSymbol "@d"))))

/-- Application of a canonicalized function and function equality. -/
private def applyEqCmd : SmtCommand :=
  .assertTerm (notSmt (eqSmt
    (selectSmt (mkSimpleSmtAppN (mkReservedSymbol "@canon") #[smtSimpleVarId gSym]) #[xId])
    (selectSmt (smtSimpleVarId gSym) #[xId])))

private def funEqCmd : SmtCommand :=
  .assertTerm (eqSmt (smtSimpleVarId gSym) (smtSimpleVarId (mkNormalSymbol "h")))

/-- Quantification over functions with a trigger on an application. -/
private def patternCmd : SmtCommand :=
  .assertTerm (mkForallTerm none #[(gSym, funSort)]
    (eqSmt (selectSmt (smtSimpleVarId gSym) #[xId]) xId)
    (some #[mkPattern #[selectSmt (smtSimpleVarId gSym) #[xId]]]))

private def higherOrderFixtures : List SmtCommand :=
  [canonCmd, applyEqCmd, patternCmd,
   .declareConst gSym funSort,
   .declareFun (mkNormalSymbol "k") #[funSort] intSort,
   .getValue (selectSmt (smtSimpleVarId gSym) #[xId]),
   .declareDataType (mkNormalSymbol "S")
     { params := none, ctors := #[(mkNormalSymbol "S.mk", some #[(mkNormalSymbol "S.fn", funSort)])] }]

private def firstOrderFixtures : List SmtCommand :=
  [.declareConst gSym intSort,
   .defineFun false (mkReservedSymbol "@isInt") #[(xSym, intSort)] boolSort (.BoolTerm true),
   .assertTerm (eqSmt xId (smtSimpleVarId gSym)),
   -- user symbols spelled like the reserved encoding symbols are not function values
   .assertTerm (eqSmt (mkSimpleSmtAppN (mkNormalSymbol "select") #[xId]) xId),
   .declareConst (mkNormalSymbol "a") (paramSort (mkNormalSymbol "Array") #[intSort, intSort]),
   .setLogic "ALL", .checkSat]

/-! # z3: the canonical encoding is sent unchanged -/

#guard (canonCmd :: applyEqCmd :: funEqCmd :: higherOrderFixtures ++ firstOrderFixtures).all
  fun c => toString (c.renderFor .z3) == toString c

/--
info: (define-fun @canon ((@f (Array  Int Int))) (Array  Int Int) (lambda ((@x0 Int))
 (ite (@isInt @x0) (select @f @x0) @d)
)
)
-/
#guard_msgs in
#eval IO.println (canonCmd.renderFor .z3)

/-! # cvc5: higher-order rendering -/

-- canonicalization: `->` sorts, `@` application, `lambda` kept
/--
info: (define-fun @canon ((@f (->  Int Int))) (->  Int Int) (lambda ((@x0 Int))
 (ite (@isInt @x0) (@ @f @x0) @d)
)
)
-/
#guard_msgs in
#eval IO.println (canonCmd.renderFor .cvc5)

-- application of a non-identifier function term
/-- info: (assert (not (= (@ (@canon g) @x0) (@ g @x0)))) -/
#guard_msgs in
#eval IO.println (applyEqCmd.renderFor .cvc5)

-- function equality is unchanged (extensional in both encodings)
#guard toString (funEqCmd.renderFor .cvc5) == toString funEqCmd

-- quantified functions and triggers
/--
info: (assert (forall ((g (->  Int Int)))
 (!(= (@ g @x0) @x0)  :pattern ( (@ g @x0)))
)
)
-/
#guard_msgs in
#eval IO.println (patternCmd.renderFor .cvc5)

-- model retrieval on function terms
/-- info: (get-value ((@ g @x0))) -/
#guard_msgs in
#eval IO.println ((SmtCommand.getValue (selectSmt (smtSimpleVarId gSym) #[xId])).renderFor .cvc5)

-- function-sorted declarations and datatype fields
/-- info: (declare-fun k ( (->  Int Int)) Int) -/
#guard_msgs in
#eval IO.println ((SmtCommand.declareFun (mkNormalSymbol "k") #[funSort] intSort).renderFor .cvc5)

-- no `Array` sort or `select` survives the cvc5 rendering
#guard higherOrderFixtures.all fun c =>
  let s := toString (c.renderFor .cvc5)
  !(s.splitOn "Array").length > 1 && !(s.splitOn "select").length > 1

-- the rendering is idempotent
#guard (higherOrderFixtures ++ firstOrderFixtures).all fun c =>
  toString (c.renderFor .cvc5) == toString ((c.renderFor .cvc5).renderFor .cvc5)

-- first-order commands (including user symbols named `select`/`Array`) are unchanged
#guard firstOrderFixtures.all fun c => toString (c.renderFor .cvc5) == toString c

/-! # Function-value detection -/

#guard higherOrderFixtures.all (·.usesFunctionValues)
#guard firstOrderFixtures.all (!·.usesFunctionValues)
-- `lambda` alone is a function value (cvc5 only parses it under `HO_ALL`)
#guard (SmtCommand.assertTerm (eqSmt (selectSmt (mkLambdaTerm #[(xSym, intSort)] xId) #[xId]) xId)).usesFunctionValues
#guard (SmtCommand.defineFun false (mkNormalSymbol "c") #[] boolSort
  (eqSmt (mkLambdaTerm #[(xSym, intSort)] xId) (mkLambdaTerm #[(xSym, intSort)] xId))).usesFunctionValues
-- function sorts nested in parameters (e.g. `List (Int → Int)`)
#guard (SmtCommand.declareConst gSym (paramSort (mkNormalSymbol "@List") #[funSort])).usesFunctionValues

/-! # Logic selection (`only-smt-lib`, no process is spawned) -/

/-- Submit `cmds` after the setup of `solver` and return the recorded setup
    commands and whether the query is marked higher-order. -/
def setupAfter (solver : SmtSolver) (cmds : List SmtCommand) :
    Lean.MetaM (Array String × Bool) := do
  let sOpts : BlasterOptions :=
    { onlySmtLib := true, solver := some solver, timeout := some 7 }
  let env : TranslateEnv := default
  let env := { env with optEnv.options.solverOptions := sOpts }
  let (_, env) ← (do setBlasterProcess; cmds.forM trySubmitCommand!).run env
  let some record := env.smtEnv.solverRecords.find? (·.solver == solver)
    | throwError "missing solver setup record"
  return (record.setupCommands.map toString, env.smtEnv.higherOrder)

-- first-order queries keep `(set-logic ALL)`
/-- info: (some "(set-logic ALL)", false) -/
#guard_msgs in
#eval do
  let (setup, ho) ← setupAfter .cvc5 firstOrderFixtures
  return (setup.back?, ho)

-- the first function value switches cvc5 to `HO_ALL`, keeping every option
/-- info: (some "(set-logic HO_ALL)", true, true) -/
#guard_msgs in
#eval do
  let (before, _) ← setupAfter .cvc5 []
  let (setup, ho) ← setupAfter .cvc5 (firstOrderFixtures ++ [canonCmd] ++ firstOrderFixtures)
  return (setup.back?, ho, setup.pop == before.pop)

-- z3 never changes: no `set-logic`, no higher-order marking
/-- info: true -/
#guard_msgs in
#eval do
  let (before, _) ← setupAfter .z3 []
  let (setup, ho) ← setupAfter .z3 (canonCmd :: higherOrderFixtures)
  return setup == before && !ho && !(setup.any (·.startsWith "(set-logic"))

end Test.SmtHigherOrderRendering
